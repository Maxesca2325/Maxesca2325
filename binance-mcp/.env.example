# Copie ce fichier en .env puis remplis-le :  cp .env.example .env && nano .env
# Ne partage JAMAIS ce fichier .env (il contient tes clés).

# Adresse du serveur. Avec sslip.io : l'IP du serveur avec des tirets, ex. 51-15-20-30.sslip.io
DOMAIN=51-15-20-30.sslip.io

# Partie secrète de l'URL du connecteur. Génère-la avec :  openssl rand -hex 32
MCP_SECRET_TOKEN=

# true = Testnet (argent fictif, clés de testnet.binance.vision)
# false = compte RÉEL (clés de binance.com). Commence par true.
BINANCE_TESTNET=true
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Garde-fous (montants dans la monnaie de cotation : EUR pour BTCEUR, USDT pour BTCUSDT)
MAX_ORDER_QUOTE=25
DAILY_MAX_QUOTE=100
ALLOWED_SYMBOLS=BTCUSDT,ETHUSDT,BTCEUR,ETHEUR
TRADING_ENABLED=true
